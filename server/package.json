{
  "name": "vit-lost-found-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for the VIT Campus Lost & Found Recovery Portal",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/init-db.js --reset && node scripts/seed.js",
    "test": "node --test test/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "sql.js": "^1.14.2",
    "zod": "^3.23.8"
  }
}
