# Copy this file to .env and adjust as needed.

# Port the API listens on
PORT=4000

# Secret used to sign login tokens. CHANGE THIS to a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts
JWT_EXPIRES_IN=7d

# SQLite database file (relative to the server/ folder)
DB_FILE=data/lostfound.db

# Origin of the React dev server (for CORS in development)
CLIENT_ORIGIN=http://localhost:5173
